<%@ page pageEncoding="UTF-8" %>
<%@ include file="../common/header.jspf" %>
<section class="pagehead"><div><p class="eyebrow">CỬA HÀNG THỜI TRANG</p><h1>Danh mục quần áo</h1><p class="muted">Quản lý các dòng sản phẩm và bộ sưu tập của cửa hàng.</p></div><a class="button" href="${pageContext.request.contextPath}/admin/category/add"><span aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v16M4 12h16"/></svg></span> Thêm danh mục</a></section>
<c:if test="${not empty flash}"><p class="notice" role="status"><c:out value="${flash}"/></p></c:if>
<section class="stats" aria-label="Thống kê danh mục"><div class="stat"><div><p>Tổng danh mục</p><strong>${allCount}</strong></div><span class="statmark purple" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span></div><div class="stat"><div><p>Đang hoạt động</p><strong>${activeCount}</strong></div><span class="statmark green" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m4 12 5 5L20 6"/></svg></span></div><div class="stat"><div><p>Đang khóa</p><strong>${lockedCount}</strong></div><span class="statmark amber" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14M16 5v14"/></svg></span></div></section>
<section class="collection"><div class="sectiontitle"><h2>Tất cả danh mục <span class="count">${total}</span></h2><span class="muted small">Mới nhất trước</span></div><form class="search" method="get" action="${pageContext.request.contextPath}/admin/categories"><label class="searchfield"><span aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></span><input type="search" name="q" value="${fn:escapeXml(q)}" placeholder="Tìm kiếm tên danh mục…" aria-label="Tìm tên danh mục"></label><button class="secondary" type="submit">Tìm kiếm</button><c:if test="${not empty q}"><a class="clear" href="${pageContext.request.contextPath}/admin/categories">Xóa lọc</a></c:if></form>
<div class="categorygrid">
<c:forEach items="${listcate}" var="cate" varStatus="st">
<article class="categorycard tone-${cate.categoryid % 4}"><div class="cardvisual"><c:choose><c:when test="${empty cate.images}"><c:set var="garmentName" value="${fn:toLowerCase(cate.categoryname)}"/>
<c:choose>
<c:when test="${fn:contains(garmentName,'váy') or fn:contains(garmentName,'đầm')}"><c:set var="garmentIcon" value="dress"/></c:when>
<c:when test="${fn:contains(garmentName,'quần')}"><c:set var="garmentIcon" value="trousers"/></c:when>
<c:when test="${fn:contains(garmentName,'khoác')}"><c:set var="garmentIcon" value="jacket"/></c:when>
<c:when test="${fn:contains(garmentName,'sơ mi')}"><c:set var="garmentIcon" value="shirt"/></c:when>
<c:when test="${fn:contains(garmentName,'phụ kiện') or fn:contains(garmentName,'túi')}"><c:set var="garmentIcon" value="bag"/></c:when>
<c:when test="${fn:contains(garmentName,'giày') or fn:contains(garmentName,'dép')}"><c:set var="garmentIcon" value="shoe"/></c:when>
<c:otherwise><c:set var="garmentIcon" value="tshirt"/></c:otherwise>
</c:choose><img class="garment" src="${pageContext.request.contextPath}/assets/illustrations/${garmentIcon}.svg" alt="" aria-hidden="true"><span class="visualword" aria-hidden="true">COLLECTION</span></c:when><c:otherwise>
<c:choose><c:when test="${fn:startsWith(cate.images, 'http://') or fn:startsWith(cate.images, 'https://')}"><c:set var="imgUrl" value="${cate.images}"/></c:when><c:otherwise><c:url var="imgUrl" value="/image"><c:param name="fname" value="${cate.images}"/></c:url></c:otherwise></c:choose><img class="coverimage" src="${fn:escapeXml(imgUrl)}" alt="Ảnh danh mục" loading="lazy" referrerpolicy="no-referrer">
</c:otherwise></c:choose><span class="badge ${cate.status == 1 ? 'on' : 'off'}"><i></i>${cate.status == 1 ? 'Hoạt động' : 'Khóa'}</span></div><div class="cardbody"><p class="cardid">DANH MỤC #${cate.categoryid}</p><h3><c:out value="${cate.categoryname}"/></h3><div class="cardbottom"><a class="edit" href="${pageContext.request.contextPath}/admin/category/edit?id=${cate.categoryid}">Chỉnh sửa <span aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 19 19 5M7 5h12v12"/></svg></span></a><form action="${pageContext.request.contextPath}/admin/category/delete" method="post" data-confirm-delete><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="categoryid" value="${cate.categoryid}"><button class="delete" type="submit" aria-label="Xóa danh mục ${fn:escapeXml(cate.categoryname)}">Xóa</button></form></div></div></article>
</c:forEach></div>
<c:if test="${empty listcate}"><div class="empty"><span class="emptyicon" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><h3>Chưa có danh mục phù hợp</h3><p>Thử tìm một tên khác hoặc thêm danh mục đầu tiên của bạn.</p><a class="button" href="${pageContext.request.contextPath}/admin/category/add"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v16M4 12h16"/></svg> Tạo danh mục</a></div></c:if>
<nav class="pagination" aria-label="Phân trang"><span>Trang ${page} / ${totalPages} <span class="pagesummary">· ${total} kết quả</span></span><div class="actions"><c:if test="${page > 1}"><c:url var="prev" value="/admin/categories"><c:param name="q" value="${q}"/><c:param name="page" value="${page - 1}"/></c:url><a class="secondary" href="${fn:escapeXml(prev)}"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H4m6-6-6 6 6 6"/></svg> Trước</a></c:if><c:if test="${page < totalPages}"><c:url var="next" value="/admin/categories"><c:param name="q" value="${q}"/><c:param name="page" value="${page + 1}"/></c:url><a class="secondary" href="${fn:escapeXml(next)}">Sau <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></c:if></div></nav></section>
<%@ include file="../common/footer.jspf" %>
