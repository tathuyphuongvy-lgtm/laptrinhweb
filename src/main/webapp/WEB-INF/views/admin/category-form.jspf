<%@ page pageEncoding="UTF-8" %>
<a class="back" href="${pageContext.request.contextPath}/admin/categories"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H4m6-6-6 6 6 6"/></svg> Quay lại danh mục</a><section class="pagehead formhead"><div><p class="eyebrow">${edit ? 'CẬP NHẬT BỘ SƯU TẬP' : 'THÊM MỘT KHỞI ĐẦU MỚI'}</p><h1>${edit ? 'Sửa danh mục' : 'Thêm danh mục'}</h1><p class="muted">Tạo bộ sưu tập thời trang phù hợp với cửa hàng.</p></div></section>
<c:if test="${not empty error}"><p class="notice error" role="alert"><c:out value="${error}"/></p></c:if>
<form class="editorgrid" action="${pageContext.request.contextPath}/admin/category/${edit ? 'update' : 'insert'}" method="post" enctype="multipart/form-data" id="category-form">
<input type="hidden" name="csrf" value="${sessionScope.csrf}"><c:if test="${edit}"><input type="hidden" name="categoryid" value="${cate.categoryid}"></c:if>
<div class="formpanel"><div class="panelheading"><span class="step">01</span><div><h2>Thông tin danh mục</h2><p>Tên nhóm quần áo và trạng thái sử dụng trong cửa hàng.</p></div></div><label for="categoryname">Tên danh mục <span class="required">*</span></label><input type="text" id="categoryname" name="categoryname" maxlength="50" required value="${fn:escapeXml(cate.categoryname)}" placeholder="Ví dụ: Áo thun nam"><div class="fieldnote"><span>Tên không trùng với danh mục đã có.</span><span id="name-count">${fn:length(cate.categoryname)}/50</span></div>
<fieldset><legend>Trạng thái hiển thị</legend><div class="statusoptions"><label class="statusoption"><input type="radio" name="status" value="1" ${cate.status == 1 ? 'checked' : ''} required><span><strong>Hoạt động</strong><small>Danh mục đang được sử dụng</small></span></label><label class="statusoption"><input type="radio" name="status" value="0" ${cate.status == 0 ? 'checked' : ''}><span><strong>Khóa</strong><small>Tạm ngưng sử dụng danh mục</small></span></label></div></fieldset>
<div class="panelseparator"></div><div class="panelheading"><span class="step">02</span><div><h2>Ảnh đại diện</h2><p>Chọn ảnh đại diện cho bộ sưu tập thời trang.</p></div></div><label for="images">Đường dẫn hình ảnh</label><input type="url" id="images" name="images" maxlength="500" placeholder="https://example.com/image.jpg" value="${fn:startsWith(cate.images, 'http') ? fn:escapeXml(cate.images) : ''}"><div class="uploadbox"><span class="uploadicon" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20V4m-6 6 6-6 6 6"/></svg></span><label for="images1">Chọn ảnh từ máy tính</label><p>PNG, JPG, GIF hoặc WebP · Tối đa 2 MB</p><input type="file" id="images1" name="images1" accept="image/png,image/jpeg,image/gif,image/webp"></div><p class="hint" id="upload-hint" aria-live="polite">Ảnh tải lên được ưu tiên hơn link ảnh.</p>
<c:if test="${not empty cate.images}"><label class="removeimage"><input type="checkbox" name="removeImage" id="remove-image" value="1"> Xóa ảnh hiện tại</label></c:if>
<div class="formactions"><button type="submit">${edit ? 'Lưu thay đổi' : 'Thêm danh mục'} <span aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 19 19 5M7 5h12v12"/></svg></span></button><a class="secondary" href="${pageContext.request.contextPath}/admin/categories">Hủy</a></div></div>
<aside class="previewpanel"><p class="previewlabel">XEM TRƯỚC</p><div class="categorycard previewcard tone-0"><div class="cardvisual"><c:choose><c:when test="${not empty cate.images}"><c:choose><c:when test="${fn:startsWith(cate.images, 'http')}"><c:set var="imgUrl" value="${cate.images}"/></c:when><c:otherwise><c:url var="imgUrl" value="/image"><c:param name="fname" value="${cate.images}"/></c:url></c:otherwise></c:choose></c:when><c:otherwise><c:set var="imgUrl" value=""/></c:otherwise></c:choose>
<img class="coverimage" id="preview-image" src="${empty imgUrl ? 'data:,' : fn:escapeXml(imgUrl)}" data-initial="${fn:escapeXml(imgUrl)}" alt="Ảnh xem trước" ${empty imgUrl ? 'hidden' : ''} referrerpolicy="no-referrer"><div class="monogram" id="preview-letter" ${not empty imgUrl ? 'hidden' : ''}><img id="preview-garment" class="garment" src="${pageContext.request.contextPath}/assets/illustrations/tshirt.svg" data-base="${pageContext.request.contextPath}/assets/illustrations/" alt=""><span id="preview-initial" class="previewinitial"><c:out value="${empty cate.categoryname ? 'M' : fn:substring(cate.categoryname,0,1)}"/></span></div><span class="visualword" aria-hidden="true">COLLECTION</span><span class="badge ${cate.status == 1 ? 'on' : 'off'}" id="preview-status"><i></i><span>${cate.status == 1 ? 'Hoạt động' : 'Khóa'}</span></span></div><div class="cardbody"><p class="cardid">${edit ? 'DANH MỤC HIỆN TẠI' : 'DANH MỤC MỚI'}</p><h3 id="preview-name"><c:out value="${empty cate.categoryname ? 'Tên danh mục của bạn' : cate.categoryname}"/></h3></div></div><p class="previewhelp">Nội dung xem trước thay đổi khi bạn nhập. Nhấn nút lưu để cập nhật danh mục.</p></aside>
</form>
