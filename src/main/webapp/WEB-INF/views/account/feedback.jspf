<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty error}"><p class="account-error" role="alert"><c:out value="${error}"/></p></c:if>
<c:if test="${not empty message}"><p class="account-message" role="status"><c:out value="${message}"/></p></c:if>
